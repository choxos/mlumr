  "boardItems": {
    "question": {
      "kind": "text",
      "source": "Compare A and B in which population?"
    },
    "assumption": {
      "kind": "text",
      "source": "In this design, the treatment and the trial always go together."
    },
    "model": {
      "kind": "katex",
      "source": "g(\\theta_k(x))=\\alpha_k+x^T\\beta_k"
    },
    "shared": {
      "kind": "text",
      "source": "Shared slopes: both treatments get the same covariate effects, on the link scale."
    },
    "integral": {
      "kind": "katex",
      "source": "\\bar\\theta_{ks}=\\int g^{-1}(\\alpha_k+x^T\\beta_k)f_s(x)\\,dx"
    },
    "joint": {
      "kind": "text",
      "source": "Summaries for each covariate, plus how they go together, define the population to average over."
    },
    "target": {
      "kind": "katex",
      "source": "\\Delta_{RD}(P)=E_P[\\theta_A(X)]-E_P[\\theta_B(X)]"
    },
    "order": {
      "kind": "text",
      "source": "In each posterior draw: predict, average, then compare."
    },
    "rank": {
      "kind": "text",
      "source": "K slopes plus one intercept need information in K + 1 directions."
    },
    "workflow": {
      "kind": "text",
      "source": "Define → prepare → integrate → fit → check → report"
    },
    "family": {
      "kind": "text",
      "source": "Match the likelihood, the link, the summaries and the effect scale."
    },
    "survival": {
      "kind": "katex",
      "source": "\\bar S_k(t)=E[S_k(t\\mid X)]"
    },
