```{r sim-load, include = FALSE}
fixed_csv <- "../data-raw/survival_optimization_fixed.csv"
fits_csv <- "../data-raw/survival_optimization_fits.csv"
manifest <- read.dcf("../data-raw/survival_optimization_manifest.dcf")[1, ]
fixed <- read.csv(fixed_csv, stringsAsFactors = FALSE)
fits <- read.csv(fits_csv, stringsAsFactors = FALSE)
# The digests of the results files this article was built from. They are
# printed below and checked by a test against the files on disk.
fixed_md5 <- unname(tools::md5sum(fixed_csv))
fits_md5 <- unname(tools::md5sum(fits_csv))

pct <- function(log_ratio) 100 * (1 - exp(-log_ratio))
# Adding zero turns a rounded negative zero into zero, so no "-0" is printed.
fmt_pct <- function(x, digits = 0) {
  formatC(round(x, digits) + 0, format = "f", digits = digits)
}
t_interval <- function(x) {
  n <- length(x)
  half <- if (n > 1) stats::qt(0.975, n - 1) * stats::sd(x) / sqrt(n) else NA_real_
  c(est = mean(x), lo = mean(x) - half, hi = mean(x) + half, n = n)
}

# ---- Level A: one row per block and method. Paired log ratios per block. ----
fixed$workload <- sub("_d[0-9]+$", "", fixed$key)
wide <- reshape(fixed[, c("key", "workload", "block", "arm", "ms_per_eval_cpu")],
                idvar = c("key", "workload", "block"), timevar = "arm",
                direction = "wide")
names(wide) <- sub("ms_per_eval_cpu.", "", names(wide), fixed = TRUE)
stopifnot(all(wide[, c("reuse", "no_reuse", "v0.2.0")] > 0))
wide$lr_off <- log(wide$no_reuse / wide$reuse)
wide$lr_old <- log(wide$`v0.2.0` / wide$reuse)
wide$lr_old_off <- log(wide$`v0.2.0` / wide$no_reuse)

# The blocks of a data set share the fixed-cost estimate subtracted from every
# run, so the data set, not the block, is the independent unit. A workload's
# estimate is the mean of its data-set means. Its interval uses the variance
# between data-set means, pooled over the workloads that share the
# distribution and the number of integration points. A data set belongs to a
# size (pseudo-individuals, integration points, covariates) and is shared by
# every distribution and model of that size, so the two models in a pool share
# their data sets and the degrees of freedom count distinct sizes.
factors <- unique(fixed[, c("workload", "distribution", "model", "n_agd",
                            "n_int", "n_cov")])
by_dataset <- stats::aggregate(cbind(lr_off, lr_old, lr_old_off) ~ key + workload,
                               data = wide, FUN = mean)
per_workload <- do.call(rbind, lapply(split(by_dataset, by_dataset$workload), function(d) {
  data.frame(workload = d$workload[1], datasets = nrow(d),
             lr_off = mean(d$lr_off), v_off = stats::var(d$lr_off),
             lr_old = mean(d$lr_old), v_old = stats::var(d$lr_old),
             lr_old_off = mean(d$lr_old_off))
}))
medians <- do.call(rbind, lapply(split(wide, wide$workload), function(w) {
  data.frame(workload = w$workload[1], ms_reuse = stats::median(w$reuse),
             ms_no_reuse = stats::median(w$no_reuse),
             ms_v020 = stats::median(w$`v0.2.0`))
}))
per_workload <- merge(merge(factors, per_workload, by = "workload"), medians,
                      by = "workload")
per_workload$group <- interaction(per_workload$distribution, per_workload$n_int,
                                  drop = TRUE)
per_workload$size <- paste(per_workload$n_agd, per_workload$n_int,
                           per_workload$n_cov)
n_sizes <- length(unique(per_workload$size))
pooled_n <- tapply(per_workload$datasets - 1, per_workload$group, sum)
pooled_df <- tapply(seq_len(nrow(per_workload)), per_workload$group, function(i) {
  sum(tapply(per_workload$datasets[i] - 1, per_workload$size[i], max))
})
stopifnot(length(unique(pooled_df)) == 1, length(unique(pooled_n)) == 1)
pool_ci <- function(est, v) {
  g <- as.character(per_workload$group)
  s2 <- tapply(v * (per_workload$datasets - 1), per_workload$group, sum) / pooled_n
  half <- stats::qt(0.975, pooled_df[g]) * sqrt(s2[g] / per_workload$datasets)
  list(lo = unname(est - half), hi = unname(est + half))
}
ci_off <- pool_ci(per_workload$lr_off, per_workload$v_off)
ci_old <- pool_ci(per_workload$lr_old, per_workload$v_old)
per_workload$lr_off_lo <- ci_off$lo
per_workload$lr_off_hi <- ci_off$hi
per_workload$lr_old_lo <- ci_old$lo
per_workload$lr_old_hi <- ci_old$hi
per_workload$saved_off <- pct(per_workload$lr_off)
per_workload$saved_old <- pct(per_workload$lr_old)

dist_label <- c(weibull = "Weibull", lognormal = "log-normal",
                gengamma = "generalized gamma", mspline = "M-spline")
per_workload$Distribution <- factor(dist_label[per_workload$distribution],
                                    levels = dist_label)
per_workload$Model <- factor(per_workload$model, levels = c("spfa", "relaxed"),
                             labels = c("SPFA", "relaxed"))

# The blocks of a data set used each of the six orders of the three methods
# equally often, so every method ran in every position equally often. A
# regression per workload with block, method, and position effects checks the
# position effect and gives the estimate adjusted for it.
n_blocks <- max(fixed$block)
reuse_first_blocks <- sum(fixed$arm == "reuse" & fixed$position == 1) /
  length(unique(fixed$key))
stopifnot(n_blocks %% 6 == 0, reuse_first_blocks == n_blocks / 3)
position_fit <- do.call(rbind, lapply(split(fixed, fixed$workload), function(d) {
  d$block_id <- interaction(d$key, d$block, drop = TRUE)
  d$method <- factor(d$arm, levels = c("reuse", "no_reuse", "v0.2.0"))
  d$position <- factor(d$position)
  m <- stats::lm(log(ms_per_eval_cpu) ~ block_id + method + position, data = d)
  cf <- stats::coef(m)
  data.frame(workload = d$workload[1], lr_off_adj = cf[["methodno_reuse"]],
             position2 = cf[["position2"]], position3 = cf[["position3"]])
}))
per_workload$lr_off_adj <- position_fit$lr_off_adj[match(per_workload$workload,
                                                         position_fit$workload)]
position_shift <- abs(pct(per_workload$lr_off_adj) - per_workload$saved_off)
position_effect <- 100 * (exp(colMeans(position_fit[, c("position2", "position3")])) - 1)
mean_off <- pct(mean(per_workload$lr_off))
mean_off_adj <- pct(mean(per_workload$lr_off_adj))

n_workloads <- nrow(per_workload)
n_units <- length(unique(fixed$key))
range_off <- range(per_workload$saved_off)
range_old <- range(per_workload$saved_old)
max_diff_off <- max(fixed$max_abs_diff_no_reuse)
max_diff_old <- max(fixed$max_abs_diff_v020)
gaps_equal <- all(fixed$max_abs_diff_no_reuse == fixed$max_abs_diff_v020)
n_points_fallback <- length(unique(fixed$key[fixed$points != "laplace"]))
min_rows <- min(fixed$n_rows)
share_min_rows <- mean(fixed$n_rows == min_rows)
run_seconds <- stats::quantile(fixed$cpu_rows, c(0.5, 1))

# ---- Level B: one row per chain and setting. --------------------------------
fits$step_ms <- 1000 * fits$sampling_s / fits$leapfrog_sampling
fit_pairs <- do.call(rbind, lapply(split(fits, fits$key), function(d) {
  on <- d[d$arm == "reuse", ]
  off <- d[d$arm == "no_reuse", ]
  on <- on[order(on$chain), ]
  off <- off[order(off$chain), ]
  data.frame(
    key = d$key[1], scenario = d$scenario[1],
    reuse_first = on$order[1] == 1,
    lr_step = mean(log(off$step_ms / on$step_ms)),
    lr_wall = log(off$wall_s[1] / on$wall_s[1]),
    lr_ess_s = log((on$ess_bulk[1] / on$wall_s[1]) /
                     (off$ess_bulk[1] / off$wall_s[1])),
    wall_on = on$wall_s[1], wall_off = off$wall_s[1],
    step_on = mean(on$step_ms), step_off = mean(off$step_ms),
    chains_identical = sum(is.na(on$first_diverging_iteration)),
    chains = nrow(on),
    mean_gap_sd = abs(on$post_mean[1] - off$post_mean[1]) / on$post_sd[1],
    divergent = sum(on$divergent) + sum(off$divergent),
    treedepth = sum(on$max_treedepth_hits) + sum(off$max_treedepth_hits),
    rhat = max(on$rhat_max[1], off$rhat_max[1]))
}))
per_scenario <- do.call(rbind, lapply(split(fit_pairs, fit_pairs$scenario), function(p) {
  st <- t_interval(p$lr_step)
  wl <- t_interval(p$lr_wall)
  es <- t_interval(p$lr_ess_s)
  data.frame(scenario = p$scenario[1], datasets = nrow(p),
             wall_on = stats::median(p$wall_on), wall_off = stats::median(p$wall_off),
             step_on = stats::median(p$step_on), step_off = stats::median(p$step_off),
             step = st[["est"]], step_lo = st[["lo"]], step_hi = st[["hi"]],
             wall = wl[["est"]], wall_lo = wl[["lo"]], wall_hi = wl[["hi"]],
             ess = es[["est"]], ess_lo = es[["lo"]], ess_hi = es[["hi"]],
             identical = sum(p$chains_identical), chains = sum(p$chains),
             max_gap_sd = max(p$mean_gap_sd), divergent = sum(p$divergent),
             treedepth = sum(p$treedepth), rhat = max(p$rhat),
             reuse_first = sum(p$reuse_first))
}))
# The order of the two fits alternates between data sets, and each scenario has
# an even number of them, so each order ran equally often.
stopifnot(all(2 * per_scenario$reuse_first == per_scenario$datasets))
per_scenario <- per_scenario[order(match(per_scenario$scenario,
                                         c("weibull_n500", "mspline_n300"))), ]
rownames(per_scenario) <- per_scenario$scenario
scenario_label <- c(weibull_n500 = "Weibull, 500 pseudo-individuals",
                    mspline_n300 = "M-spline, 300 pseudo-individuals")

# Work done by the two settings of each scenario, summed over data sets and
# chains: leapfrog steps in sampling and warmup time.
work <- stats::aggregate(cbind(leapfrog_sampling, warmup_s) ~ scenario + arm,
                         data = fits, FUN = sum)
more_work <- function(scenario, what) {
  w <- work[work$scenario == scenario, ]
  100 * (w[[what]][w$arm == "no_reuse"] / w[[what]][w$arm == "reuse"] - 1)
}
# Chains that separated, and those whose draws already differed at the first
# sampling iteration, that is, chains that separated during warmup.
first_div <- fits$first_diverging_iteration[fits$arm == "reuse"]
n_separated <- sum(!is.na(first_div))
n_separated_warmup <- sum(first_div == 1, na.rm = TRUE)
max_mcse_sd <- max(fits$post_mcse / fits$post_sd)

# ---- Quantities quoted in the text. -----------------------------------------
fixed_caption <- paste(
  "Saving in time per evaluation from predictor reuse, relative to the",
  "computation without it, by distribution (columns), number of covariates",
  "(rows), number of integration points (horizontal axis), number of",
  "pseudo-individuals (color), and model (line type). Each point is a",
  "workload estimate, expressed as a percentage.")
fmt_ci <- function(est, lo, hi, digits = 1) {
  sprintf("%s%% (95%% interval %s%% to %s%%)", fmt_pct(pct(est), digits),
          fmt_pct(pct(lo), digits), fmt_pct(pct(hi), digits))
}
workload_ci <- function(workload) {
  w <- per_workload[per_workload$workload == workload, ]
  fmt_ci(w$lr_off, w$lr_off_lo, w$lr_off_hi)
}
scenario_ci <- function(scenario, what) {
  s <- per_scenario[scenario, ]
  fmt_ci(s[[what]], s[[paste0(what, "_lo")]], s[[paste0(what, "_hi")]])
}
scenario_ratio <- function(scenario, what) {
  s <- per_scenario[scenario, ]
  sprintf("%.2f (95%% interval %.2f to %.2f)", exp(s[[what]]),
          exp(s[[paste0(what, "_lo")]]), exp(s[[paste0(what, "_hi")]]))
}
factor_pct <- function(var) {
  agg <- stats::aggregate(per_workload$lr_off, list(level = per_workload[[var]]),
                          mean)
  stats::setNames(fmt_pct(pct(agg$x), 1), as.character(agg$level))
}
by_dist <- factor_pct("Distribution")
by_model <- factor_pct("Model")
by_agd <- factor_pct("n_agd")
by_int <- factor_pct("n_int")
by_cov <- factor_pct("n_cov")
n_reduced <- sum(per_workload$lr_off_lo > 0)
n_increased <- sum(per_workload$lr_off_hi < 0)
median_off <- stats::median(per_workload$saved_off)
range_ms <- range(per_workload$ms_reuse)
# The 0.2.0 models against the computation without predictor reuse: the
# workload estimates are averaged within each size, whose data sets are
# separate, and a t interval is taken over the sizes.
old_off <- t_interval(tapply(per_workload$lr_old_off, per_workload$size, mean))
longer <- function(log_ratio) 100 * (exp(log_ratio) - 1)
# Counts up to twelve are written as words in the text.
as_words <- function(n) {
  words <- c("one", "two", "three", "four", "five", "six", "seven", "eight",
             "nine", "ten", "eleven", "twelve")
  if (n >= 1 && n <= 12 && n == round(n)) words[n] else format(n)
}

# Data sets whose parameter values fell back to the origin. Within the
# workloads where one data set used the fallback values and the other the
# Laplace draws, the difference between the two data sets' log time ratios.
points_by_key <- unique(fixed[, c("key", "distribution", "points")])
fallback_by_dist <- table(points_by_key$distribution[points_by_key$points != "laplace"])
fallback_text <- knitr::combine_words(
  sprintf("%d %s", as.integer(fallback_by_dist), dist_label[names(fallback_by_dist)]))
by_dataset$laplace <- points_by_key$points[match(by_dataset$key, points_by_key$key)] ==
  "laplace"
dataset_pairs <- split(by_dataset, by_dataset$workload)
mixed <- Filter(function(d) length(unique(d$laplace)) == 2, dataset_pairs)
both_laplace <- Filter(function(d) all(d$laplace), dataset_pairs)
mixed_diff <- vapply(mixed, function(d) {
  d$lr_off[!d$laplace] - d$lr_off[d$laplace]
}, numeric(1))
# Workloads of one size share data sets, so the interval is taken over sizes.
mixed_size <- per_workload$size[match(names(mixed), per_workload$workload)]
fallback_diff <- t_interval(tapply(mixed_diff, mixed_size, mean))
n_mixed_sizes <- length(unique(mixed_size))
sd_fallback_diff <- stats::sd(mixed_diff)
sd_laplace_diff <- stats::sd(vapply(both_laplace, function(d) diff(d$lr_off),
                                    numeric(1)))

n_chains_identical <- stats::setNames(per_scenario$identical, per_scenario$scenario)
n_chains <- stats::setNames(per_scenario$chains, per_scenario$scenario)
n_datasets <- stats::setNames(per_scenario$datasets, per_scenario$scenario)
```

Survival fits spend most of their time on the comparator likelihood. Each
reconstructed comparator pseudo-individual is integrated over the covariate
distribution of the comparator population [@Phillippo2025surv; @ChandlerIshakMLUMR], so the
comparator contributes one likelihood term per pseudo-individual and
integration point, and the sampler evaluates all of them, with their gradient,
at every leapfrog step.

From version 0.2.1 the survival models compute the comparator linear predictor
once per arm instead of once per pseudo-individual. This *predictor reuse* is
on by default. It changes how the log density is computed, not the model and
not the posterior distribution.

This vignette covers three things:

1. how to turn the optimization off, and when that is useful;
2. what predictor reuse changes in the computation, and why draws can still
   differ in their final digits;
3. a simulation study that compares survival fits with and without the
   optimization, both per evaluation of the log density and in complete fits.

## The `optimization` argument

```{r usage, eval = FALSE}
library(mlumr)

# Predictor reuse (the default).
fit <- mlumr(dat, distribution = "weibull")
# The computation of releases before 0.2.1.
fit_ref <- mlumr(dat, distribution = "weibull", optimization = FALSE)
```

The setting is stored in the fit as `fit$model_controls$optimization`, and
`prior_sensitivity()` refits the model with the same setting. A fit made with a
release before 0.2.1 records no setting; `prior_sensitivity()` refits it with
`optimization = FALSE`, the computation it used.

In this release the argument affects survival fits only. Binary, continuous,
and count fits ignore it. It is unrelated to Stan's optimization algorithms:
the posterior distribution is always explored by Markov chain Monte Carlo
sampling.

There are two reasons to turn the optimization off:

* to benchmark it, as in the study below;
* to repeat the computation of a release before 0.2.1, so that a fit made with
  such a release can be reproduced exactly. This also requires the same Stan
  version, compiler, and seed.

## What predictor reuse changes

The comparator evidence in a survival fit is reconstructed pseudo-individual
data. The likelihood of each pseudo-individual is integrated over the covariate
distribution of the comparator population, as in multilevel network
meta-regression for general likelihoods [@Phillippo2025surv] and its unanchored
form, multilevel unanchored meta-regression [@ChandlerIshakMLUMR]. With
integration points
$x_{a1}, \dots, x_{aM}$ for comparator arm $a$, the likelihood contribution of
pseudo-individual $j$, with observed time $t_j$ and event indicator $d_j$, is

$$
L_j = \frac{1}{M} \sum_{m=1}^{M} f\!\left(t_j, d_j \mid \eta_{am}\right),
\qquad
\eta_{am} = \mu_{C} + x_{am}^{\top} \beta,
$$

where $f$ is the density or survival function of the chosen distribution,
$\mu_C$ is the comparator intercept, and $\beta$ is the vector of comparator
covariate coefficients.

The linear predictors $\eta_{a1}, \dots, \eta_{aM}$ depend on the arm and the
parameters but not on $j$. Releases before 0.2.1 nevertheless recomputed them
for every pseudo-individual: one product of the $M \times n_B$ design matrix
with the coefficient vector per pseudo-individual and per evaluation of the log
density, where $n_B$ is the number of design columns. With predictor reuse they
are computed once per arm and evaluation, and shared by all pseudo-individuals
in the arm.

Stan computes the gradient of the log density by reverse-mode automatic
differentiation [@Carpenter2017], and the No-U-Turn sampler [@Hoffman2014]
evaluates this gradient at every leapfrog step. Each matrix-vector product
creates $M$ new values in the expression graph, with the bookkeeping needed to
differentiate them, and in the reverse pass propagates $M$ adjoints into $n_B$
coefficients. Predictor reuse removes all but one product per arm. It leaves
unchanged the $n_{\text{agd}} \times M$ likelihood terms $f$, the likelihood of
the index study, and the priors.

The saving per evaluation is therefore the share of the total cost that the
removed products account for. It should be larger when the design is wider
(more covariates, or the relaxed model with its separate comparator
coefficients) and the likelihood terms are inexpensive. It should be smaller
when the likelihood terms or the index study dominate the cost.

### Same posterior, different final digits

Both computations evaluate the same function. The matrix-vector products give
identical values, but the reverse pass adds up the contributions to each
coefficient's gradient in a different order: once per arm after summing over
pseudo-individuals, instead of once per pseudo-individual. Floating-point
addition is not associative, so the two gradients can differ in their final
digits.

The posterior distribution is the same. Under a common seed the draws coincide
until such differences accumulate along the sampler's trajectory, which can
happen as early as warmup, and they agree in distribution throughout. The
package's parity tests (`tests/parity/` in the source repository) compare, for
each of 52 test cases and both settings, the log density, its gradient, the
parameter transforms, and every generated quantity against the 0.2.0 models.

## Simulation design

The study answers three questions:

1. How much time does predictor reuse save per evaluation of the log density
   and its gradient, the operation repeated at every leapfrog step, and how
   does the saving depend on the distribution, the model, the number of
   comparator pseudo-individuals $n_{\text{agd}}$, the number of integration
   points $M$, and the number of covariates $K$?
2. How much of that saving reaches a complete `mlumr()` fit?
3. Did the computations with and without predictor reuse, and the 0.2.0 models,
   give the same values in every run?

The questions concern computation time and numerical agreement, not bias or
coverage. The script that ran the study is a development file, kept in the
package repository and not installed with the package:
[`data-raw/simulate_survival_optimization.R`](https://github.com/choxos/mlumr/blob/main/data-raw/simulate_survival_optimization.R).
It writes a manifest beside its results recording the software and hardware
used. The numbers below were read from results files with MD5 digests
`r fixed_md5` (per-evaluation timings) and `r fits_md5` (complete fits); a
package test compares these digests against the files in the repository.

### The data

One data-generating mechanism is used throughout, as a benchmark. Computation
time depends mainly on the code path of the fitted model and on the sample
sizes. It also depends on the data values: through the mix of event and
censoring indicators, through branches of the generalized gamma likelihood that
the values of time and of the parameters select, and, in complete fits, through
the sampler's trajectories. The study does not vary these systematically.

* An index study of 200 individuals and a comparator cohort of
  $n_{\text{agd}}$ individuals are generated in the same way.
* The $K$ covariates alternate between continuous (normal, SD 1) and binary.
  The comparator population is shifted by 0.2 on the continuous covariates and
  has prevalence 0.45, against 0.5 in the index population, on the binary
  covariates.
* Event times follow a Weibull proportional hazards model with shape 1.2,
  coefficients 0.3, -0.2, 0.15, -0.1, 0.25, and -0.15 (the first $K$ of
  these), a baseline median of about five months, and a conditional log hazard
  ratio of -0.4 for the index treatment.
* Censoring times are independent and exponential with rate 0.02 per month,
  with administrative censoring at 24 months: right censoring only, without
  delayed entry.
* The comparator cohort's times and event indicators are supplied to
  `set_agd_surv()` as its pseudo-individual data, with its realized covariate
  means, standard deviations, and proportions. For computation this is
  equivalent to a digitized Kaplan-Meier curve.
* Integration points come from `add_integration()` with its default Gaussian
  copula. The restricted mean survival time (RMST) is computed to 18 months,
  and predictions are made at 6, 12, and 18 months.

Each data set is shared by every distribution and model of the same size, so
those comparisons are made on the same individuals.

### Three computations

* **With predictor reuse** (`optimization = TRUE`): the 0.2.1 survival models,
  which compute the linear predictor once per comparator arm.
* **Without predictor reuse** (`optimization = FALSE`): the same compiled
  models, which recompute the linear predictor for every pseudo-individual.
* **Version 0.2.0**: the survival models as released in mlumr 0.2.0, kept
  unchanged in the repository for the parity tests. They answer two further
  questions: whether 0.2.1 is faster than the previous release, and whether
  the switch between the two computations adds any cost when predictor reuse
  is off.

### Level A: one evaluation at a time

**Workloads.** Every combination of distribution (Weibull, log-normal,
generalized gamma, and the M-spline flexible baseline), model (SPFA and
relaxed), $n_{\text{agd}}$ (100, 500, 2000), $M$ (16, 64, 256), and $K$ (1, 3,
6): `r n_workloads` workloads, each with two data sets. The piecewise
exponential baseline shares the likelihood code of the M-spline baseline and is
not measured separately.

**Measurement.** Time is measured inside the CmdStan executable that
`mlumr(engine = "cmdstanr")` uses, through CmdStan's `log_prob` method. It reads
a file of parameter values and, for each row, evaluates the log density and its
gradient and writes the result. The CPU time of a run over $N$ rows, minus the
median CPU time of three runs over five rows, divided by $N - 5$, estimates the
cost per row without process start-up, data input, and model construction.
The three short runs are made once per data set and method, so all blocks of a
data set share this subtraction.

The cost per row is one evaluation of the log density and its gradient, plus
reading one row of parameter values and writing one row of results. The reading
and writing are the same for the three computations; they dilute the relative
savings slightly for the least expensive workloads without favoring any of
them. $N$ is chosen per data set so that a run lasts about 0.5 s, with a
minimum of `r min_rows` rows, and is the same for all three computations. The
minimum applied to `r fmt_pct(100 * share_min_rows)`% of runs, and the longest
run took `r sprintf("%.1f", run_seconds[[2]])` s of CPU time.

**Parameter values.** The timings use five draws from CmdStan's Laplace
approximation at the posterior mode of each data set, so that they are taken
where the sampler spends its time.
`r if (n_points_fallback) paste0("For ", n_points_fallback, " of the ", n_units, " data sets (", fallback_text, ") the posterior mode could not be located, and the origin together with four small perturbations of it was used instead.") else "The posterior mode was located for every data set."`

**Pairing.** Each data set is timed in `r as_words(n_blocks)` blocks, and each
block runs each of the three computations once. The blocks use each of the six
possible orders of the three computations `r as_words(n_blocks / 6)` times, in
random sequence, so every computation runs in every position in
`r as_words(n_blocks / 3)` of the `r as_words(n_blocks)` blocks of every data
set. Data sets are processed in random order, so that any drift in timing over
the run is spread across the experimental factors.

**Estimate and interval.** For each block the quantity of interest is the log
ratio of the time per evaluation without predictor reuse to the time with it,
and likewise for the 0.2.0 models. The blocks of a data set share the
subtracted cost of the short runs, so the data set, not the block, is the
independent unit. The estimate for a workload is the mean of its two data-set
means, each the mean of `r as_words(n_blocks)` block log ratios.

With two data sets per workload, the variance between data-set means cannot be
estimated reliably for each workload on its own. It is pooled over the
`r unique(pooled_n)` workloads that share the distribution and the number of
integration points. The two models of a given size are fitted to the same data
sets, so these workloads hold `r unique(pooled_df)` independent pairs of data
sets, and the 95% interval for a workload uses the $t$ distribution with
`r unique(pooled_df)` degrees of freedom. Results are reported as the
percentage saving in time per evaluation, $100\,(1 - 1/\text{ratio})$.

### Level B: complete fits

**Scenarios.** Two SPFA scenarios with three covariates and 64 integration
points: a Weibull baseline with 500 comparator pseudo-individuals and an
M-spline baseline with 300, each with ten data sets.

**Fits.** Each data set is fitted with `optimization = TRUE` and with
`optimization = FALSE` through `mlumr(engine = "cmdstanr")` with the default
sampler settings (four chains of 2000 iterations, 1000 of them warmup,
`adapt_delta = 0.95`, `max_treedepth = 15`). The four chains run in parallel,
and both fits use the same seed and hence the same initial values. The order of
the two settings alternates between data sets, so each order is used for half
of the data sets. Draws are written with 18 significant digits.

A chain *follows a common trajectory* under both settings when, at every
sampling iteration, each sampled parameter (the regression coefficients and the
auxiliary and spline parameters) differs between the settings by at most
$10^{-6} \max(1, |x|)$, where $x$ is its value with predictor reuse. This
tolerance admits the rounding differences described above but not a separation
of trajectories.

**What is compared.** The main quantity is the sampling time per leapfrog step,
paired by data set and chain. It is dominated by the cost of a step within the
actual sampler. The sampling time also includes work done once per iteration
(the generated quantities and the writing of draws), so it is not entirely
independent of the number of steps per iteration, but it is much less
sensitive to that number than the elapsed time is. The elapsed time of the
`mlumr()` call and the bulk effective sample size (ESS) of the
comparator-population RMST difference per second of elapsed time are also
reported. Each is summarized as the mean of the log ratios over data sets, with
a $t$ interval; with ten data sets these intervals are wide.

### The machine

```{r machine, echo = FALSE}
fields <- c("CPU", "Cores", "Memory-GB", "Platform", "R", "CmdStan", "cmdstanr",
            "Compiler", "mlumr", "Commit")
labels <- c("Processor", "Cores", "Memory (GB)", "Platform", "R", "CmdStan",
            "cmdstanr", "Compiler", "mlumr", "Commit")
knitr::kable(data.frame(Item = labels, Value = unname(manifest[fields])),
             row.names = FALSE, caption = "Hardware and software used.")
load_max <- as.numeric(manifest[["Load-max"]])
# One load per fit: every chain row of a fit records the same value.
fit_load <- fits$load1[!duplicated(fits[, c("key", "arm")])]
```

Everything ran on the single machine above; mlumr `r manifest[["mlumr"]]` is
the development version of 0.2.1. Level A ran one CmdStan process at a time;
Level B ran the four chains of each fit in parallel. A unit of either level
started only when the one-minute load average was below
`r manifest[["Load-max"]]`. The load average was recorded right after each
timed run in Level A, with median `r sprintf("%.1f", stats::median(fixed$load1))`
(range `r sprintf("%.1f", min(fixed$load1))` to
`r sprintf("%.1f", max(fixed$load1))`), and at the start of each fit in Level
B, with median `r sprintf("%.1f", stats::median(fits$load1))` (range
`r sprintf("%.1f", min(fits$load1))` to `r sprintf("%.1f", max(fits$load1))`).
The one-minute load average decays over about a minute, so these values include
the unit's own preceding runs as well as other activity on the machine, and
the two cannot be separated. In Level B a unit is a pair of fits, so the
threshold was checked before the first fit of each pair only;
`r sum(fit_load > load_max)` of the `r length(fit_load)` fits started above
it.`r if (max(fit_load) > 2 * load_max) sprintf(" Load averages above %d, up to %.1f, are too high to come from the study's own four chains and reflect other work on the machine during part of Level B.", 2 * load_max, max(fit_load)) else ""`

## What the study found

```{r claims, include = FALSE}
# The headings and paragraphs below state qualitative findings. They hold for
# the committed results files; a rerun could make any of them false while every
# other check stayed green, so the article stops building instead.
agree_tol <- 1e-8
stopifnot(
  # The computations agree to rounding.
  max(max_diff_off, max_diff_old) < agree_tol,
  # No workload's interval indicates a slowdown.
  n_increased == 0,
  # Every distribution and both models are faster on average.
  all(as.numeric(by_dist) > 0), all(as.numeric(by_model) > 0),
  # The M-spline baseline gains most and the generalized gamma least.
  as.numeric(by_dist[["M-spline"]]) == max(as.numeric(by_dist)),
  as.numeric(by_dist[["generalized gamma"]]) == min(as.numeric(by_dist)),
  # Wider designs gain more; more integration points gain less.
  as.numeric(by_cov[["6"]]) > as.numeric(by_cov[["1"]]),
  as.numeric(by_model[["relaxed"]]) > as.numeric(by_model[["SPFA"]]),
  as.numeric(by_int[["16"]]) > as.numeric(by_int[["256"]]),
  # The 0.2.0 models and the computation without reuse differ by under 1%.
  abs(longer(old_off[["lo"]])) < 1, abs(longer(old_off[["hi"]])) < 1,
  # In both scenarios the savings per leapfrog step and in elapsed time
  # exclude zero.
  per_scenario["weibull_n500", "step_lo"] > 0,
  per_scenario["weibull_n500", "wall_lo"] > 0,
  per_scenario["mspline_n300", "step_lo"] > 0,
  per_scenario["mspline_n300", "wall_lo"] > 0,
  # The Weibull saving in elapsed time is smaller than its saving per step.
  per_scenario["weibull_n500", "wall"] < per_scenario["weibull_n500", "step"],
  # The M-spline point estimates exceed the Weibull ones, and its saving in
  # elapsed time exceeds its saving per step, with the fits without reuse
  # taking more leapfrog steps in sampling.
  per_scenario["mspline_n300", "step"] > per_scenario["weibull_n500", "step"],
  per_scenario["mspline_n300", "wall"] > per_scenario["weibull_n500", "wall"],
  per_scenario["mspline_n300", "wall"] > per_scenario["mspline_n300", "step"],
  more_work("mspline_n300", "leapfrog_sampling") > 0,
  # No M-spline chain followed a common trajectory.
  n_chains_identical[["mspline_n300"]] == 0,
  # Later positions in a block are slower than the first.
  all(position_effect > 0),
  # Savings at fallback and Laplace points do not differ systematically.
  fallback_diff[["lo"]] < 0, fallback_diff[["hi"]] > 0
)
```

In short: predictor reuse cut the time per evaluation of the log density and
its gradient by `r fmt_pct(median_off, 1)`% in the median workload and by up to
`r fmt_pct(range_off[2])`%. The largest savings came with the M-spline
baseline, wide designs, and few integration points, and the smallest with the
generalized gamma distribution. In complete fits the elapsed time fell by about
`r fmt_pct(pct(per_scenario["weibull_n500", "wall"]))`% with the Weibull
baseline and `r fmt_pct(pct(per_scenario["mspline_n300", "wall"]))`% with the
M-spline baseline. Because the
optimization is on by default, survival fits get this saving without any change
to user code.

### The computations agree to the final digits

Across the `r n_units` data sets of Level A, the largest absolute difference in
the log density or in any component of its gradient between the computations
with and without predictor reuse, over all parameter values timed, was
`r formatC(max_diff_off, format = "g", digits = 2)`; between predictor reuse
and the 0.2.0 models it was `r formatC(max_diff_old, format = "g", digits = 2)`.
`r if (gaps_equal) "In every data set the two differences were identical, which is consistent with the computation without predictor reuse and the 0.2.0 models producing identical output." else ""`

```{r fit-agreement, echo = FALSE}
agree <- per_scenario[, c("scenario", "datasets", "identical", "chains",
                          "max_gap_sd", "divergent", "treedepth", "rhat")]
agree$scenario <- scenario_label[agree$scenario]
agree$max_gap_sd <- formatC(agree$max_gap_sd, format = "g", digits = 2)
agree$rhat <- formatC(agree$rhat, format = "f", digits = 3)
names(agree) <- c("Scenario", "Data sets", "Chains on a common trajectory",
                  "Chains", "Largest difference in posterior mean (posterior SDs)",
                  "Divergent transitions", "Transitions at maximum tree depth",
                  "Largest R-hat")
knitr::kable(agree, row.names = FALSE,
             caption = paste("Agreement between the complete fits with and",
                             "without predictor reuse. A chain followed a",
                             "common trajectory when every sampled parameter",
                             "agreed between the two settings to within",
                             "1e-6 max(1, |x|) at every sampling iteration."))
```

In the complete fits, `r n_chains_identical[["weibull_n500"]]` of the
`r n_chains[["weibull_n500"]]` Weibull chains and
`r n_chains_identical[["mspline_n300"]]` of the
`r n_chains[["mspline_n300"]]` M-spline chains followed a common trajectory
under both settings throughout sampling. Of the `r n_separated` chains that
separated, `r n_separated_warmup` had done so by the first sampling iteration,
that is, during warmup. Separated chains are still sampling the same posterior:
in every pair of fits the posterior means of the RMST difference differed by at
most `r formatC(max(per_scenario$max_gap_sd), format = "f", digits = 3)`
posterior standard deviations, comparable with the Monte Carlo standard error
of a single fit's posterior mean (at most
`r formatC(max_mcse_sd, format = "f", digits = 3)` posterior standard
deviations).

### Every distribution and both models run faster

```{r center-table, echo = FALSE}
center <- per_workload[per_workload$n_agd == 500 & per_workload$n_int == 64 &
                         per_workload$n_cov == 3, ]
center <- center[order(center$Distribution, center$Model), ]
ci <- function(est, lo, hi) {
  sprintf("%s (%s to %s)", fmt_pct(pct(est)), fmt_pct(pct(lo)), fmt_pct(pct(hi)))
}
knitr::kable(data.frame(
  Distribution = center$Distribution, Model = center$Model,
  `ms per evaluation, reuse` = formatC(center$ms_reuse, format = "f", digits = 2),
  `Saving vs no reuse, %` = ci(center$lr_off, center$lr_off_lo, center$lr_off_hi),
  `Saving vs 0.2.0, %` = ci(center$lr_old, center$lr_old_lo, center$lr_old_hi),
  check.names = FALSE), row.names = FALSE,
  caption = paste("Time per evaluation of the log density and its gradient",
                  "with 500 pseudo-individuals, 64 integration points, and",
                  "three covariates, and the percentage saving from",
                  "predictor reuse, with 95% intervals."))
```

Across all `r n_workloads` workloads, the estimated saving in time per
evaluation ranged from `r fmt_pct(range_off[1])`% to `r fmt_pct(range_off[2])`%
relative to the computation without predictor reuse, and from
`r fmt_pct(range_old[1])`% to `r fmt_pct(range_old[2])`% relative to the 0.2.0
models; a negative value is an increase. The 95% interval excluded no change in
`r n_reduced` of the `r n_workloads` workloads, and in
`r if (n_increased == 0) "none" else n_increased` did it indicate an increase.
The median time per evaluation with predictor reuse, by workload, ranged from
`r formatC(range_ms[1], format = "f", digits = 2)` ms to
`r formatC(range_ms[2], format = "f", digits = 0)` ms.

```{r fixed-figure, echo = FALSE, fig.height = 6.5, fig.cap = fixed_caption, fig.alt = fixed_caption}
ggplot(per_workload, aes(x = n_int, y = saved_off, color = factor(n_agd),
                         linetype = Model)) +
  geom_hline(yintercept = 0, color = "grey60") +
  geom_line() +
  geom_point(size = 1.2) +
  facet_grid(paste(n_cov, "covariates") ~ Distribution) +
  scale_x_log10(breaks = c(16, 64, 256)) +
  labs(x = "Integration points (log scale)",
       y = "Saving in time per evaluation (%)",
       color = "Pseudo-individuals", linetype = "Model") +
  theme_bw() +
  theme(legend.position = "bottom")
```

### The saving follows the share of the cost that reuse removes

```{r main-effects, echo = FALSE}
main <- function(var, label) {
  agg <- stats::aggregate(per_workload$lr_off, list(level = per_workload[[var]]),
                          mean)
  data.frame(Factor = label, Level = as.character(agg$level),
             `Saving vs no reuse, %` = fmt_pct(pct(agg$x)), check.names = FALSE)
}
knitr::kable(rbind(main("Distribution", "Distribution"), main("Model", "Model"),
                   main("n_agd", "Pseudo-individuals"),
                   main("n_int", "Integration points"),
                   main("n_cov", "Covariates")),
             row.names = FALSE,
             caption = paste("Saving in time per evaluation from predictor",
                             "reuse by level of each factor, averaged over the",
                             "other factors (geometric mean of the time",
                             "ratios)."))
```

The saving was largest for the M-spline baseline (`r by_dist[["M-spline"]]`%
on average over the other factors) and smallest for the generalized gamma
distribution (`r by_dist[["generalized gamma"]]`%), whose likelihood terms
evaluate incomplete gamma functions and so leave the removed products a smaller
share of the total cost.

The other factors behave as the structure of the computation predicts. The
saving grew with the number of covariates, from `r by_cov[["1"]]`% with one
covariate to `r by_cov[["6"]]`% with six, and was larger for the relaxed model
than for the SPFA model (`r by_model[["relaxed"]]`% against
`r by_model[["SPFA"]]`%), since both widen the design. It grew slightly with
the number of pseudo-individuals, from `r by_agd[["100"]]`% at 100 to
`r by_agd[["2000"]]`% at 2000, as the fixed cost of the index study's
likelihood became a smaller share of the total.

It fell with the number of integration points, from `r by_int[["16"]]`% at 16
to `r by_int[["64"]]`% at 64 and `r by_int[["256"]]`% at 256. The operation
count alone does not predict this, because both the removed products and the
likelihood terms grow linearly with $M$. A fall followed by a plateau is
consistent with a cost per product that does not grow with $M$, such as the
bookkeeping needed to differentiate each product, which is a larger share of
the total when $M$ is small.

### Turning reuse off costs what 0.2.0 cost

The savings relative to the 0.2.0 models are close to those relative to the
computation without predictor reuse, because the two take nearly the same
time. Averaged over workloads, the 0.2.0 models took
`r fmt_pct(longer(old_off[["est"]]), 1)`% longer than the computation without
predictor reuse (95% interval `r fmt_pct(longer(old_off[["lo"]]), 1)`% to
`r fmt_pct(longer(old_off[["hi"]]), 1)`%, computed over the `r n_sizes`
data-set sizes). The data flag that selects between the two computations does
not slow down `optimization = FALSE`.

### The saving reaches complete fits

```{r fits-table, echo = FALSE}
knitr::kable(data.frame(
  Scenario = scenario_label[per_scenario$scenario],
  `Data sets` = per_scenario$datasets,
  `Elapsed time (s), reuse` = round(per_scenario$wall_on),
  `Elapsed time (s), no reuse` = round(per_scenario$wall_off),
  `Saving per leapfrog step, %` = ci(per_scenario$step, per_scenario$step_lo,
                                     per_scenario$step_hi),
  `Saving in elapsed time, %` = ci(per_scenario$wall, per_scenario$wall_lo,
                                   per_scenario$wall_hi),
  `ESS per second, ratio` = sprintf("%.2f (%.2f to %.2f)", exp(per_scenario$ess),
                                    exp(per_scenario$ess_lo),
                                    exp(per_scenario$ess_hi)),
  check.names = FALSE), row.names = FALSE,
  caption = paste("Elapsed times are medians over data sets. Savings are",
                  "means of the log ratios over data sets, expressed as",
                  "percentages. The ESS ratio is the bulk ESS of the RMST",
                  "difference per second with predictor reuse divided by that",
                  "without it. All intervals are 95% t intervals."))
```

In the Weibull scenario predictor reuse cut the sampling time per leapfrog
step by `r scenario_ci("weibull_n500", "step")`, in line with the Level A
estimate of `r workload_ci("weibull_spfa_agd0500_int064_cov3")` for the same
distribution, model, sample size, number of integration points, and number of
covariates. The elapsed time of the `mlumr()` call fell by
`r scenario_ci("weibull_n500", "wall")`, and the bulk ESS of the RMST
difference per second rose by a factor of
`r scenario_ratio("weibull_n500", "ess")`.

In the M-spline scenario the point estimates were larger: a saving of
`r scenario_ci("mspline_n300", "step")` per leapfrog step and
`r scenario_ci("mspline_n300", "wall")` in elapsed time, against
`r workload_ci("mspline_spfa_agd0500_int064_cov3")` per evaluation in Level A
at 500 pseudo-individuals. Both intervals exclude no change. In the Weibull
scenario the saving in elapsed time is smaller than the saving per leapfrog
step, as expected when work that predictor reuse does not touch dilutes it. In
the M-spline scenario it is larger. No M-spline chain followed a common
trajectory under the two settings, so the number of leapfrog steps differed
between them by chance; the fits without predictor reuse took
`r fmt_pct(more_work("mspline_n300", "leapfrog_sampling"), 1)`% more leapfrog
steps in sampling in total. These differences reflect the sampler's paths
rather than an effect of predictor reuse. That is why the time per leapfrog
step is the main quantity compared.

### Checks on the timing design

**Position within a block.** Times were slightly shorter in the first position
of a block: relative to it, times were on average
`r fmt_pct(position_effect[["position2"]], 1)`% longer in the second position
and `r fmt_pct(position_effect[["position3"]], 1)`% longer in the third. A
linear model for the log time per workload, with effects of block, computation,
and position, gives estimates adjusted for position. The adjustment changed the
workload estimates of the saving by a median of
`r fmt_pct(stats::median(position_shift), 1)` and at most
`r fmt_pct(max(position_shift), 1)` percentage points, and changed the mean
saving over all workloads from `r fmt_pct(mean_off, 1)`% to
`r fmt_pct(mean_off_adj, 1)`%.

**Fallback parameter values.** In the `r length(mixed)` workloads in which one
data set was timed at the fallback parameter values and the other at Laplace
draws, the log time ratio at the fallback values minus that at the Laplace
draws, averaged within each of the `r n_mixed_sizes` data-set sizes involved
and then over sizes, was `r sprintf("%.3f", fallback_diff[["est"]])` (95%
interval `r sprintf("%.3f", fallback_diff[["lo"]])` to
`r sprintf("%.3f", fallback_diff[["hi"]])`), with standard deviation
`r sprintf("%.3f", sd_fallback_diff)` across workloads. For comparison, the
difference between the two data sets of the workloads in which both used
Laplace draws had standard deviation `r sprintf("%.3f", sd_laplace_diff)`.

## What this vignette does not claim

The timings come from one machine and one compiler, through CmdStan
(`engine = "cmdstanr"`) only. Absolute times, and to a lesser extent the
relative savings, depend on the processor, the compiler, and its optimization
flags. The results are not claimed to hold on other hardware or for the rstan
engine.

The two levels measure different things. Level A is the CPU time of a single
process evaluating the log density and its gradient at fixed parameter values.
Level B is the elapsed time of complete `mlumr()` calls whose four chains ran
in parallel, which also includes data preparation, the generated quantities,
reading the sampler output, and post-processing, and depends on how many
leapfrog steps the sampler takes. When both settings take the same number of
steps, the work that predictor reuse does not touch dilutes the saving, so the
saving in elapsed time should be smaller than the saving per evaluation. Once
trajectories separate, the number of steps differs between the settings by
chance, and the saving in elapsed time of a single fit can be larger or smaller
than the saving per evaluation, as in the M-spline scenario.

The Level A intervals assume that the variance between the data-set means of a
workload is the same for all workloads with the same distribution and number
of integration points. With two data sets per workload this cannot be checked
for each workload, and the pooled estimates for workloads that share data sets
are correlated. The pooled variance includes both the variation between data
sets and the error of the short runs subtracted from all blocks of a data set.

Level B has two scenarios with ten data sets each, and its intervals are
wide. The saving in elapsed time for other distributions, sample sizes, numbers
of integration points, or for the relaxed model was not measured directly; it
can be inferred only from the corresponding Level A workloads.

One data-generating mechanism was used, with right censoring only. Delayed
entry and left or interval censoring add terms to each likelihood evaluation
and would be expected to shrink the share of the cost that predictor reuse
removes. For `r n_points_fallback` data sets the timings were taken at fallback
parameter values rather than at draws near the posterior mode. The cost of the
incomplete gamma functions in the generalized gamma likelihood depends on the
parameter values, but within workloads the savings at the two kinds of points
did not differ systematically (see the checks above). That comparison is
between different data sets; no data set was timed at both kinds of points.

Each unit started only when the load average was below the stated threshold,
but the machine was not otherwise idle; the recorded load averages are reported
above. Background activity adds variability to single timings. In Level A, the
random order of data sets and the placement of every computation in every
position within blocks limit its effect on the comparison. In Level B, the
order of the two fits of a pair may also affect timing; each order was used for
half of the data sets of each scenario.

The processor has four performance cores and four efficiency cores, and the
operating system decided which processes ran on which. A chain scheduled on an
efficiency core runs more slowly, which is a plausible source of the
variability between data sets in Level B, where four chains ran at once.

## Reproducing the study

From the root of the package source, with that source installed:

```{r reproduce, eval = FALSE}
# Each stage records every completed unit and resumes from there if interrupted.
system("Rscript data-raw/simulate_survival_optimization.R fixed")
system("Rscript data-raw/simulate_survival_optimization.R fits")
system("Rscript data-raw/simulate_survival_optimization.R assemble")
```

The final stage writes the results files and the manifest, which records the
commit of the package source, the software versions, and the machine.

## References
