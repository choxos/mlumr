```{r sim-load, include = FALSE}
fixed_csv <- "../data-raw/survival_performance_fixed.csv"
fits_csv <- "../data-raw/survival_performance_fits.csv"
manifest <- read.dcf("../data-raw/survival_performance_manifest.dcf")[1, ]
fixed <- read.csv(fixed_csv, stringsAsFactors = FALSE)
fits <- read.csv(fits_csv, stringsAsFactors = FALSE)
# The digests of the results files this article was built from. They are
# printed below and checked by a test against the files on disk.
fixed_md5 <- unname(tools::md5sum(fixed_csv))
fits_md5 <- unname(tools::md5sum(fits_csv))

pct <- function(log_ratio) 100 * (1 - exp(-log_ratio))
# Adding zero turns a rounded negative zero into zero, so no "-0" is printed.
fmt_pct <- function(x, digits = 0) {
  formatC(round(x, digits) + 0, format = "f", digits = digits)
}
t_interval <- function(x) {
  n <- length(x)
  half <- if (n > 1) stats::qt(0.975, n - 1) * stats::sd(x) / sqrt(n) else NA_real_
  c(est = mean(x), lo = mean(x) - half, hi = mean(x) + half, n = n)
}

# ---- Level A: one row per block and arm. Paired log ratios per block. -------
fixed$workload <- sub("_d[0-9]+$", "", fixed$key)
wide <- reshape(fixed[, c("key", "workload", "block", "arm", "ms_per_eval_cpu")],
                idvar = c("key", "workload", "block"), timevar = "arm",
                direction = "wide")
names(wide) <- sub("ms_per_eval_cpu.", "", names(wide), fixed = TRUE)
n_nonpositive <- sum(wide[, c("reuse", "no_reuse", "v0.2.0")] <= 0)
wide <- wide[wide$reuse > 0 & wide$no_reuse > 0 & wide$`v0.2.0` > 0, ]
wide$lr_off <- log(wide$no_reuse / wide$reuse)
wide$lr_old <- log(wide$`v0.2.0` / wide$reuse)
wide$lr_old_off <- log(wide$`v0.2.0` / wide$no_reuse)

factors <- unique(fixed[, c("workload", "distribution", "model", "n_agd",
                            "n_int", "n_cov")])
per_workload <- do.call(rbind, lapply(split(wide, wide$workload), function(w) {
  off <- t_interval(w$lr_off)
  old <- t_interval(w$lr_old)
  oo <- t_interval(w$lr_old_off)
  data.frame(workload = w$workload[1], blocks = nrow(w),
             ms_reuse = stats::median(w$reuse),
             ms_no_reuse = stats::median(w$no_reuse),
             ms_v020 = stats::median(w$`v0.2.0`),
             lr_off = off[["est"]], lr_off_lo = off[["lo"]], lr_off_hi = off[["hi"]],
             lr_old = old[["est"]], lr_old_lo = old[["lo"]], lr_old_hi = old[["hi"]],
             lr_old_off = oo[["est"]])
}))
per_workload <- merge(factors, per_workload, by = "workload")
per_workload$saved_off <- pct(per_workload$lr_off)
per_workload$saved_old <- pct(per_workload$lr_old)

dist_label <- c(weibull = "Weibull", lognormal = "log-normal",
                gengamma = "generalized gamma", mspline = "M-spline")
per_workload$Distribution <- factor(dist_label[per_workload$distribution],
                                    levels = dist_label)
per_workload$Model <- factor(per_workload$model, levels = c("spfa", "relaxed"),
                             labels = c("SPFA", "relaxed"))

n_workloads <- nrow(per_workload)
n_units <- length(unique(fixed$key))
n_blocks_total <- nrow(wide)
range_off <- range(per_workload$saved_off)
range_old <- range(per_workload$saved_old)
max_diff_off <- max(fixed$max_abs_diff_no_reuse)
max_diff_old <- max(fixed$max_abs_diff_v020)
n_points_fallback <- length(unique(fixed$key[fixed$points != "laplace"]))

# ---- Level B: one row per chain and setting. --------------------------------
fits$step_ms <- 1000 * fits$sampling_s / fits$leapfrog_sampling
fit_pairs <- do.call(rbind, lapply(split(fits, fits$key), function(d) {
  on <- d[d$arm == "reuse", ]
  off <- d[d$arm == "no_reuse", ]
  on <- on[order(on$chain), ]
  off <- off[order(off$chain), ]
  data.frame(
    key = d$key[1], scenario = d$scenario[1],
    lr_step = mean(log(off$step_ms / on$step_ms)),
    lr_wall = log(off$wall_s[1] / on$wall_s[1]),
    lr_ess_s = log((on$ess_bulk[1] / on$wall_s[1]) /
                     (off$ess_bulk[1] / off$wall_s[1])),
    wall_on = on$wall_s[1], wall_off = off$wall_s[1],
    step_on = mean(on$step_ms), step_off = mean(off$step_ms),
    chains_identical = sum(is.na(on$first_diverging_iteration)),
    chains = nrow(on),
    first_div = suppressWarnings(min(on$first_diverging_iteration, na.rm = TRUE)),
    mean_gap_sd = abs(on$post_mean[1] - off$post_mean[1]) / on$post_sd[1],
    divergent = sum(on$divergent) + sum(off$divergent),
    treedepth = sum(on$max_treedepth_hits) + sum(off$max_treedepth_hits),
    rhat = max(on$rhat_max[1], off$rhat_max[1]))
}))
per_scenario <- do.call(rbind, lapply(split(fit_pairs, fit_pairs$scenario), function(p) {
  st <- t_interval(p$lr_step)
  wl <- t_interval(p$lr_wall)
  es <- t_interval(p$lr_ess_s)
  data.frame(scenario = p$scenario[1], datasets = nrow(p),
             wall_on = stats::median(p$wall_on), wall_off = stats::median(p$wall_off),
             step_on = stats::median(p$step_on), step_off = stats::median(p$step_off),
             step = st[["est"]], step_lo = st[["lo"]], step_hi = st[["hi"]],
             wall = wl[["est"]], wall_lo = wl[["lo"]], wall_hi = wl[["hi"]],
             ess = es[["est"]], ess_lo = es[["lo"]], ess_hi = es[["hi"]],
             identical = sum(p$chains_identical), chains = sum(p$chains),
             max_gap_sd = max(p$mean_gap_sd), divergent = sum(p$divergent),
             treedepth = sum(p$treedepth), rhat = max(p$rhat))
}))
per_scenario <- per_scenario[order(match(per_scenario$scenario,
                                         c("weibull_n500", "mspline_n300"))), ]
scenario_label <- c(weibull_n500 = "Weibull, 500 pseudo-individuals",
                    mspline_n300 = "M-spline, 300 pseudo-individuals")

# ---- Quantities quoted in the text. -----------------------------------------
fixed_caption <- paste(
  "Reduction in time per evaluation with predictor reuse, relative to the",
  "computation without it, by distribution (columns), number of covariates",
  "(rows), number of integration points (horizontal axis), number of",
  "pseudo-individuals (color), and model (line type). Points are workload",
  "means of 16 block log ratios, expressed as percentages.")
fmt_ci <- function(est, lo, hi, digits = 1) {
  sprintf("%s%% (95%% interval %s%% to %s%%)", fmt_pct(pct(est), digits),
          fmt_pct(pct(lo), digits), fmt_pct(pct(hi), digits))
}
workload_ci <- function(workload) {
  w <- per_workload[per_workload$workload == workload, ]
  fmt_ci(w$lr_off, w$lr_off_lo, w$lr_off_hi)
}
scenario_ci <- function(scenario, what) {
  s <- per_scenario[per_scenario$scenario == scenario, ]
  fmt_ci(s[[what]], s[[paste0(what, "_lo")]], s[[paste0(what, "_hi")]])
}
scenario_ratio <- function(scenario, what) {
  s <- per_scenario[per_scenario$scenario == scenario, ]
  sprintf("%.2f (95%% interval %.2f to %.2f)", exp(s[[what]]),
          exp(s[[paste0(what, "_lo")]]), exp(s[[paste0(what, "_hi")]]))
}
factor_pct <- function(var) {
  agg <- stats::aggregate(per_workload$lr_off, list(level = per_workload[[var]]),
                          mean)
  stats::setNames(fmt_pct(pct(agg$x), 1), as.character(agg$level))
}
by_dist <- factor_pct("Distribution")
by_model <- factor_pct("Model")
by_agd <- factor_pct("n_agd")
by_int <- factor_pct("n_int")
by_cov <- factor_pct("n_cov")
n_reduced <- sum(per_workload$lr_off_lo > 0)
n_increased <- sum(per_workload$lr_off_hi < 0)
median_off <- stats::median(per_workload$saved_off)
ratio_old_off <- exp(mean(per_workload$lr_old_off))
range_ms <- range(per_workload$ms_reuse)

# Data sets whose parameter values fell back to the origin, and the mean
# reduction at each kind of point within the distributions affected.
points_by_key <- unique(fixed[, c("key", "distribution", "points")])
fallback_by_dist <- table(points_by_key$distribution[points_by_key$points != "laplace"])
fallback_text <- knitr::combine_words(
  sprintf("%d %s", as.integer(fallback_by_dist), dist_label[names(fallback_by_dist)]))
wide_points <- merge(wide, points_by_key, by = "key")
wide_points <- wide_points[wide_points$distribution %in% names(fallback_by_dist), ]
by_points <- stats::aggregate(lr_off ~ distribution + I(points == "laplace"),
                              data = wide_points, mean)
names(by_points) <- c("distribution", "laplace", "lr_off")
max_points_gap <- max(abs(tapply(pct(by_points$lr_off), by_points$distribution,
                                 function(x) diff(range(x)))))

# Level B: the second fit of each pair starts under the residual load of the
# first, so the order of the settings is recorded. Weighting the two orders
# equally removes the imbalance when a scenario has an odd number of data sets.
fit_pairs$reuse_first <- vapply(split(fits, fits$key), function(d) {
  d$order[d$arm == "reuse"][1] == 1
}, logical(1))[fit_pairs$key]
fit_pairs$gap_mcse <- vapply(split(fits, fits$key), function(d) {
  on <- d[d$arm == "reuse", ][1, ]
  off <- d[d$arm == "no_reuse", ][1, ]
  abs(on$post_mean - off$post_mean) / sqrt(on$post_mcse^2 + off$post_mcse^2)
}, numeric(1))[fit_pairs$key]
order_balanced <- vapply(split(fit_pairs, fit_pairs$scenario), function(p) {
  mean(tapply(p$lr_step, p$reuse_first, mean))
}, numeric(1))
reuse_first_n <- tapply(fit_pairs$reuse_first, fit_pairs$scenario, sum)
max_gap_mcse <- max(fit_pairs$gap_mcse)
n_chains_identical <- stats::setNames(per_scenario$identical, per_scenario$scenario)
n_chains <- stats::setNames(per_scenario$chains, per_scenario$scenario)
n_datasets <- stats::setNames(per_scenario$datasets, per_scenario$scenario)
```

Multilevel unanchored meta-regression (ML-UMR) compares a treatment for which
individual patient data are available from a single-arm study with a
comparator for which only aggregate evidence is published, adjusting for
differences between the covariate distributions of the two populations
[@ChandlerIshakMLUMR]. In its extension to time-to-event outcomes
[@ChandlerIshak2026], the likelihood of the comparator evidence is integrated
over the covariate distribution of the comparator population, which multiplies
the number of likelihood terms by the number of integration points. The cost
of evaluating the log posterior density, and hence the duration of a fit, is
therefore dominated by the comparator likelihood.

The `mlumr()` argument `optimization` controls computational optimizations:
changes to the way in which the log posterior density and its gradient are
evaluated that leave the statistical model, and therefore the posterior
distribution, unchanged. This article documents the optimization introduced in
version 0.2.1, the per-arm reuse of the comparator linear predictor in the
survival models (hereafter *predictor reuse*), and reports a simulation study
of its effect on computation time. Optimizations introduced in later releases
will be documented and evaluated in this article in the same manner.

## The `optimization` argument

Optimizations are enabled by default and are disabled with
`optimization = FALSE`:

```{r usage, eval = FALSE}
fit <- mlumr(dat, distribution = "weibull")                          # predictor reuse (default)
fit_ref <- mlumr(dat, distribution = "weibull", optimization = FALSE) # as in releases before 0.2.1
```

The setting is stored in the fitted object as `fit$model_controls$optimization`,
and `prior_sensitivity()` refits the model with the same setting. In the
present release the argument affects the survival family only; it has no
effect for binary, continuous, or count outcomes. It is unrelated to Stan's
optimization algorithms: the posterior distribution is always explored by
Markov chain Monte Carlo sampling.

Disabling optimizations serves two purposes: benchmarking, as in the study
reported below, and reproducing, operation by operation, a fit obtained with an
earlier release.

## The modified computation

In a survival fit the comparator evidence consists of reconstructed
pseudo-individual data, and the likelihood of each pseudo-individual is
integrated over the covariate distribution of the comparator population, in
the manner of the population adjustment of multilevel network meta-regression
[@Phillippo2020]. With integration points $x_{a1}, \dots, x_{aM}$ for
comparator arm $a$, the likelihood contribution of pseudo-individual $j$, with
observed time $t_j$ and event indicator $d_j$, is

$$
L_j = \frac{1}{M} \sum_{m=1}^{M} f\!\left(t_j, d_j \mid \eta_{am}\right),
\qquad
\eta_{am} = \mu_{C} + x_{am}^{\top} \beta,
$$

where $f$ is the density or survival function of the chosen distribution,
$\mu_C$ is the comparator intercept, and $\beta$ is the vector of comparator
covariate coefficients. The linear predictors $\eta_{a1}, \dots, \eta_{aM}$
depend on the arm and on the parameters but not on $j$. Releases before 0.2.1
nevertheless recomputed them for every pseudo-individual: one product of the
$M \times n_B$ design matrix with the coefficient vector per pseudo-individual
and per evaluation of the log density, where $n_B$ is the number of design
columns. With predictor reuse they are computed once per arm and evaluation and
shared by all pseudo-individuals in the arm.

Stan evaluates the gradient of the log density by reverse-mode automatic
differentiation [@Carpenter2017], and the No-U-Turn sampler [@Hoffman2014]
evaluates this gradient at every leapfrog step. Each matrix-vector product adds
$M$ nodes to the expression graph and, in the reverse pass, propagates $M$
adjoints into $n_B$ coefficients. Predictor reuse removes all but one product
per arm. It leaves unchanged the $n_{\text{agd}} \times M$ likelihood terms
$f$, the likelihood of the index study, and the priors. The relative reduction
per evaluation therefore equals the share of the total cost that is
attributable to the removed products. It is expected to be larger when the
design is wider (more covariates, or the relaxed model with its separate
comparator coefficients) and the likelihood terms are inexpensive, and smaller
when the likelihood terms or the index study dominate the cost.

Both computations evaluate the same function. The matrix-vector products yield
identical values, but the reverse pass accumulates the contributions to each
coefficient's gradient in a different order: once per arm after summation over
pseudo-individuals, rather than once per pseudo-individual. Because
floating-point addition is not associative, the two gradients may differ in
their final digits. The posterior distribution is identical; under a common
seed the draws coincide until such differences accumulate along the sampler's
trajectory, and they agree in distribution throughout. The package's parity
tests (`tests/parity/` in the source repository) compare, for each of 52
workloads and both settings, the log density, its gradient, the parameter
transforms, and every generated quantity against the 0.2.0 models.

## Simulation study design

The design is reported following the ADEMP structure of @Morris2019: aims,
data-generating mechanisms, estimands, methods, and performance measures. The
estimands are computational rather than statistical: the study measures
computation time and verifies numerical agreement, rather than bias or
coverage.

The study was implemented in the script
[`data-raw/simulate_survival_performance.R`](https://github.com/choxos/mlumr/blob/main/data-raw/simulate_survival_performance.R),
which is part of the package source repository but is not installed with the
package. The script writes, alongside its results, a manifest that records the
software and hardware used. The results reported below were computed from
files with MD5 digests `r fixed_md5` (per-evaluation timings) and
`r fits_md5` (complete fits); a package test verifies these digests against
the files in the repository.

### Aims

1. **A1.** To estimate the reduction in time per evaluation of the log density
   and its gradient, the operation repeated at every leapfrog step of the
   sampler, and its dependence on the fitted distribution, the model, the
   number of comparator pseudo-individuals $n_{\text{agd}}$, the number of
   integration points $M$, and the number of covariates $K$.
2. **A2.** To estimate the part of that reduction that carries over to a
   complete `mlumr()` fit.
3. **A3.** To verify that the computations with and without predictor reuse,
   and the 0.2.0 models, produced the same values in every run of the study.

### Data-generating mechanism

A single data-generating mechanism was used throughout, because the
computation time depends on the code path of the fitted model and, for given
sample sizes, depends on the data only through the mix of event and censoring
indicators.

* An index study of 200 individuals and a comparator cohort of
  $n_{\text{agd}}$ individuals were generated in the same way.
* The $K$ covariates alternated between continuous (normal, SD 1) and binary.
  The comparator population was shifted by 0.2 on the continuous covariates and
  had prevalence 0.45, against 0.5 in the index population, on the binary
  covariates.
* Event times followed a Weibull proportional hazards model with shape 1.2,
  coefficients 0.3, -0.2, 0.15, -0.1, 0.25, and -0.15 (the first $K$ of
  these), a baseline median of approximately five months, and a conditional
  log hazard ratio of -0.4 for the index treatment.
* Censoring times were independent and exponentially distributed with rate
  0.02 per month, with administrative censoring at 24 months: right censoring
  only, without delayed entry.
* The comparator cohort's times and event indicators were supplied to
  `set_agd_surv()` as its pseudo-individual data, together with its realized
  covariate means, standard deviations, and proportions. For the purposes of
  computation this is equivalent to a digitized Kaplan-Meier curve.
* Integration points were generated by `add_integration()` with its default
  Gaussian copula. The restricted mean survival time (RMST) was computed to
  18 months, and predictions were made at 6, 12, and 18 months.

Each data set was shared by every fitted distribution and model of the same
size, so that these comparisons were made on the same individuals.

### Methods compared

* **With predictor reuse** (`optimization = TRUE`): the 0.2.1 survival models,
  which compute the linear predictor once per comparator arm.
* **Without predictor reuse** (`optimization = FALSE`): the same compiled
  models, which recompute the linear predictor for every pseudo-individual.
* **Version 0.2.0**: the survival models as released in mlumr 0.2.0, retained
  unchanged in the repository for the parity tests. This comparison addresses
  two further questions: whether version 0.2.1 is faster than the previous
  release, and whether the switch between the two computations adds any cost
  when predictor reuse is disabled.

### Level A: time per evaluation

**Workloads.** The workloads comprised every combination of fitted
distribution (Weibull, log-normal, generalized gamma, and the M-spline flexible
baseline), model (SPFA and relaxed), $n_{\text{agd}}$ (100, 500, 2000), $M$
(16, 64, 256), and $K$ (1, 3, 6): `r n_workloads` workloads, each with two
data sets. The piecewise exponential baseline shares the likelihood code of
the M-spline baseline and was not measured separately.

**Measurement.** Time was measured inside the CmdStan executable used by
`mlumr(engine = "cmdstanr")`, through CmdStan's `log_prob` method, which
evaluates the log density and its gradient at every row of a file of parameter
values. The difference between the CPU time of a run over $N$ rows and that of
a run over five rows, divided by $N - 5$, estimates the cost of a single
evaluation with process start-up, data input, and model construction removed.
$N$ was chosen for each data set so that a run lasted approximately 0.5 s, and
was the same for all three methods.

**Parameter values.** The parameter values were five draws from CmdStan's
Laplace approximation at the posterior mode of each data set, so that timings
were taken in the region of the parameter space explored by the sampler.
`r if (n_points_fallback) paste0("For ", n_points_fallback, " of the ", n_units, " data sets (", fallback_text, ") the posterior mode could not be located, and the origin together with four small perturbations of it was used instead.") else "The posterior mode was located for every data set."`

**Pairing.** Each data set was timed in eight blocks. Within a block, each of
the three methods was run once, in an order balanced so that each method
occupied the first, second, and third position equally often across blocks.
Data sets were processed in random order, so that any temporal drift in timing
was distributed across the experimental factors.

**Estimand and uncertainty.** For each block, the estimand was the log ratio
of the time per evaluation without predictor reuse to the time with it, and
likewise for the 0.2.0 models. The estimate for a workload was the mean of its
16 block log ratios (two data sets of eight blocks each), with a 95% interval
from the $t$ distribution. Results are reported as the percentage reduction in
time per evaluation, $100\,(1 - 1/\text{ratio})$.

### Level B: complete fits

**Scenarios.** Two SPFA scenarios with three covariates and 64 integration
points were studied: a Weibull baseline with 500 comparator pseudo-individuals
(ten data sets) and an M-spline baseline with 300 (five data sets). The smaller
number of M-spline data sets, which reflects the longer run time of these fits,
was fixed before any fit was run.

**Fits.** Each data set was fitted with `optimization = TRUE` and with
`optimization = FALSE` through `mlumr(engine = "cmdstanr")` with the default
sampler settings (four chains of 2000 iterations, of which 1000 were warmup,
`adapt_delta = 0.95`, `max_treedepth = 15`). The four chains ran in parallel,
and both fits used the same seed and hence the same initial values. The order
of the two settings alternated between data sets. Draws were written with 18
significant digits, so that a chain could be recognized as following a common
trajectory under both settings: its draws agreed to a relative tolerance of
$10^{-6}$ at every sampling iteration, a tolerance that admits the rounding
differences described above but not a separation of trajectories.

**Estimands.** The primary estimand was the sampling time per leapfrog step,
paired by data set and chain. It measures the cost of a step within the actual
sampler and does not depend on the number of steps that a fit happened to
take. The secondary estimands were the elapsed time of the `mlumr()` call and
the bulk effective sample size (ESS) of the comparator-population RMST
difference per second of elapsed time. Each was summarized as the mean of the
log ratios over data sets, with a $t$ interval; with five or ten data sets
these intervals are necessarily wide.

### Computing environment

```{r machine, echo = FALSE}
fields <- c("CPU", "Cores", "Memory-GB", "Platform", "R", "CmdStan", "cmdstanr",
            "Compiler", "mlumr", "Commit")
labels <- c("Processor", "Cores", "Memory (GB)", "Platform", "R", "CmdStan",
            "cmdstanr", "Compiler", "mlumr", "Commit")
knitr::kable(data.frame(Item = labels, Value = unname(manifest[fields])),
             row.names = FALSE, caption = "Hardware and software used.")
```

All computations were performed on the single machine described above. Level
A ran one CmdStan process at a time; Level B ran the four chains of each fit on
four cores. A unit of either level was started only when the one-minute load
average was below `r manifest[["Load-max"]]`. At the start of the timed runs
the load average had a median of
`r sprintf("%.1f", stats::median(fixed$load1))` (range
`r sprintf("%.1f", min(fixed$load1))` to `r sprintf("%.1f", max(fixed$load1))`)
in Level A and a median of `r sprintf("%.1f", stats::median(fits$load1))`
(range `r sprintf("%.1f", min(fits$load1))` to
`r sprintf("%.1f", max(fits$load1))`) in Level B. The threshold applied to the
start of a unit; the load averages recorded at later runs within a unit include
the unit's own earlier runs (in Level B, the four chains of the first fit of
the pair), which accounts for the values above the threshold.

## Results

### Agreement

Across the `r n_units` data sets of Level A, the largest absolute difference in
the log density or in any component of its gradient between the computations
with and without predictor reuse, over all parameter values timed, was
`r formatC(max_diff_off, format = "g", digits = 2)`; between predictor reuse
and the 0.2.0 models it was `r formatC(max_diff_old, format = "g", digits = 2)`.

```{r fit-agreement, echo = FALSE}
agree <- per_scenario[, c("scenario", "datasets", "identical", "chains",
                          "max_gap_sd", "divergent", "treedepth", "rhat")]
agree$scenario <- scenario_label[agree$scenario]
agree$max_gap_sd <- formatC(agree$max_gap_sd, format = "g", digits = 2)
agree$rhat <- formatC(agree$rhat, format = "f", digits = 3)
names(agree) <- c("Scenario", "Data sets", "Chains on a common trajectory",
                  "Chains", "Largest difference in posterior mean (posterior SDs)",
                  "Divergent transitions", "Transitions at maximum tree depth",
                  "Largest R-hat")
knitr::kable(agree, row.names = FALSE,
             caption = paste("Agreement between the complete fits with and",
                             "without predictor reuse. A chain followed a",
                             "common trajectory when its draws under the two",
                             "settings agreed to a relative tolerance of",
                             "1e-6 at every sampling iteration."))
```

### Time per evaluation

```{r center-table, echo = FALSE}
center <- per_workload[per_workload$n_agd == 500 & per_workload$n_int == 64 &
                         per_workload$n_cov == 3, ]
center <- center[order(center$Distribution, center$Model), ]
ci <- function(est, lo, hi) {
  sprintf("%s (%s to %s)", fmt_pct(pct(est)), fmt_pct(pct(lo)), fmt_pct(pct(hi)))
}
knitr::kable(data.frame(
  Distribution = center$Distribution, Model = center$Model,
  `ms per evaluation, reuse` = formatC(center$ms_reuse, format = "f", digits = 2),
  `Reduction vs no reuse, %` = ci(center$lr_off, center$lr_off_lo, center$lr_off_hi),
  `Reduction vs 0.2.0, %` = ci(center$lr_old, center$lr_old_lo, center$lr_old_hi),
  check.names = FALSE), row.names = FALSE,
  caption = paste("Time per evaluation of the log density and its gradient",
                  "with 500 pseudo-individuals, 64 integration points, and",
                  "three covariates, and the percentage reduction obtained",
                  "with predictor reuse, with 95% intervals."))
```

Across all `r n_workloads` workloads, the estimated reduction in time per
evaluation ranged from `r fmt_pct(range_off[1])`% to
`r fmt_pct(range_off[2])`% relative to the computation without predictor
reuse, and from `r fmt_pct(range_old[1])`% to `r fmt_pct(range_old[2])`%
relative to the 0.2.0 models; a negative value denotes an increase. The time
per evaluation with predictor reuse
ranged from `r formatC(range_ms[1], format = "f", digits = 2)` ms to
`r formatC(range_ms[2], format = "f", digits = 0)` ms. Within the
distributions for which some data sets were evaluated at the fallback
parameter values, the mean reduction at those values differed from that at the
Laplace draws by at most `r fmt_pct(max_points_gap, 1)` percentage points.

```{r fixed-figure, echo = FALSE, fig.height = 6.5, fig.cap = fixed_caption, fig.alt = fixed_caption}
ggplot(per_workload, aes(x = n_int, y = saved_off, color = factor(n_agd),
                         linetype = Model)) +
  geom_hline(yintercept = 0, color = "grey60") +
  geom_line() +
  geom_point(size = 1.2) +
  facet_grid(paste(n_cov, "covariates") ~ Distribution) +
  scale_x_log10(breaks = c(16, 64, 256)) +
  labs(x = "Integration points (log scale)",
       y = "Reduction in time per evaluation (%)",
       color = "Pseudo-individuals", linetype = "Model") +
  theme_bw() +
  theme(legend.position = "bottom")
```

```{r main-effects, echo = FALSE}
main <- function(var, label) {
  agg <- stats::aggregate(per_workload$lr_off, list(level = per_workload[[var]]),
                          mean)
  data.frame(Factor = label, Level = as.character(agg$level),
             `Reduction vs no reuse, %` = fmt_pct(pct(agg$x)), check.names = FALSE)
}
knitr::kable(rbind(main("Distribution", "Distribution"), main("Model", "Model"),
                   main("n_agd", "Pseudo-individuals"),
                   main("n_int", "Integration points"),
                   main("n_cov", "Covariates")),
             row.names = FALSE,
             caption = paste("Reduction in time per evaluation with predictor",
                             "reuse by level of each factor, averaged over the",
                             "other factors (geometric mean of the time",
                             "ratios)."))
```

### Complete fits

```{r fits-table, echo = FALSE}
knitr::kable(data.frame(
  Scenario = scenario_label[per_scenario$scenario],
  `Data sets` = per_scenario$datasets,
  `Elapsed time (s), reuse` = round(per_scenario$wall_on),
  `Elapsed time (s), no reuse` = round(per_scenario$wall_off),
  `Reduction per leapfrog step, %` = ci(per_scenario$step, per_scenario$step_lo,
                                        per_scenario$step_hi),
  `Reduction in elapsed time, %` = ci(per_scenario$wall, per_scenario$wall_lo,
                                      per_scenario$wall_hi),
  `ESS per second, ratio` = sprintf("%.2f (%.2f to %.2f)", exp(per_scenario$ess),
                                    exp(per_scenario$ess_lo),
                                    exp(per_scenario$ess_hi)),
  check.names = FALSE), row.names = FALSE,
  caption = paste("Elapsed times are medians over data sets. Reductions are",
                  "means of the log ratios over data sets, expressed as",
                  "percentages. The ESS ratio is the bulk ESS of the RMST",
                  "difference per second with predictor reuse divided by that",
                  "without it. All intervals are 95% t intervals."))
```

## Discussion

### Principal findings

**Time per evaluation (A1).** Averaged over the other factors, predictor reuse
reduced the time per evaluation of the log density and its gradient for every
distribution and for both models. The 95% interval excluded no change in
`r n_reduced` of the `r n_workloads` workloads, and in
`r if (n_increased == 0) "none" else n_increased` did it indicate an increase.
The reduction was largest for the M-spline baseline
(`r by_dist[["M-spline"]]`% on average over the other factors) and smallest for
the generalized gamma distribution (`r by_dist[["generalized gamma"]]`%), whose
likelihood terms evaluate incomplete gamma functions and therefore leave the
removed products a smaller share of the total cost.

The dependence on the other factors agreed with the structure of the
computation. The reduction increased with the number of covariates, from
`r by_cov[["1"]]`% with one covariate to `r by_cov[["6"]]`% with six, and was
larger for the relaxed model than for the SPFA model (`r by_model[["relaxed"]]`%
against `r by_model[["SPFA"]]`%), since both widen the design. It increased
slightly with the number of pseudo-individuals, from `r by_agd[["100"]]`% at
100 to `r by_agd[["2000"]]`% at 2000, as the fixed cost of the index study's
likelihood became a smaller share of the total. It decreased with the number
of integration points, from `r by_int[["16"]]`% at 16 to `r by_int[["256"]]`%
at 256. The operation count does not predict this dependence, because both the
removed products and the likelihood terms grow linearly with $M$; it is
consistent with a cost per product that does not grow with $M$, such as the
creation and traversal of the product's node in the expression graph.

The reductions relative to the 0.2.0 models were close to those relative to
the computation without predictor reuse, because the latter took essentially
the same time as the 0.2.0 models: over all workloads, the geometric mean
ratio of the time of the 0.2.0 models to that without predictor reuse was
`r sprintf("%.3f", ratio_old_off)`. The data flag that selects between the two
computations therefore adds no measurable cost.

**Complete fits (A2).** In the Weibull scenario predictor reuse reduced the
sampling time per leapfrog step by `r scenario_ci("weibull_n500", "step")`, in
agreement with the Level A estimate of
`r workload_ci("weibull_spfa_agd0500_int064_cov3")` for the same distribution,
model, sample size, number of integration points, and number of covariates.
The elapsed time of the `mlumr()` call was reduced by
`r scenario_ci("weibull_n500", "wall")`, and the bulk ESS of the RMST
difference per second increased by a factor of
`r scenario_ratio("weibull_n500", "ess")`.
In the M-spline scenario the point
estimates were larger, a reduction of
`r scenario_ci("mspline_n300", "step")` per leapfrog step and
`r scenario_ci("mspline_n300", "wall")` in elapsed time, compared with
`r workload_ci("mspline_spfa_agd0500_int064_cov3")` per evaluation in Level A
at 500 pseudo-individuals. With five data sets these intervals include no
change, and the M-spline estimates are not conclusive.

**Agreement (A3).** At every parameter value timed, the log density and its
gradient computed with and without predictor reuse, and by the 0.2.0 models,
agreed to within `r formatC(max(max_diff_off, max_diff_old), format = "g", digits = 2)`
in absolute value. In the complete fits,
`r n_chains_identical[["weibull_n500"]]` of the
`r n_chains[["weibull_n500"]]` Weibull chains and
`r n_chains_identical[["mspline_n300"]]` of the
`r n_chains[["mspline_n300"]]` M-spline chains followed a common trajectory
under both settings throughout sampling. The other chains separated, as
expected once differences in the final digits of the gradient accumulate along
a trajectory.
In every pair of fits the posterior means of the RMST difference differed by at
most `r formatC(max(per_scenario$max_gap_sd), format = "f", digits = 3)`
posterior standard deviations, or
`r formatC(max_gap_mcse, format = "f", digits = 1)` times the Monte Carlo
standard error of their difference, which is consistent with Monte Carlo
variation alone.

### Limitations

All timings were obtained on one machine with one compiler, and through
CmdStan (`engine = "cmdstanr"`) only. Absolute times, and to a lesser extent
the relative reductions, depend on the processor, the compiler, and its
optimization flags; the results are not claimed to hold for other hardware or
for the rstan engine.

The two levels measure different quantities. Level A reports the CPU time of a
single process that evaluates the log density and its gradient at fixed
parameter values. Level B reports the elapsed time of complete `mlumr()` calls
whose four chains ran in parallel. Besides the gradient evaluations of warmup
and sampling, this time includes data preparation, the generated quantities
(computed once per draw and without automatic differentiation), reading the
sampler output, and post-processing. Predictor reuse affects these components
little or not at all, so the Level A reductions are an approximate upper limit
for the reduction in elapsed time.

The interval for each Level A workload pools 16 block log ratios from two data
sets as if they were exchangeable. The time ratio is expected to vary little
between data sets of the same size, because it is determined by the code path
rather than by the data values, but the interval does not separate variation
between data sets from variation within them.

Level B comprised two scenarios with ten and five data sets, and its intervals
are correspondingly wide. The reduction in elapsed time for other
distributions, sample sizes, numbers of integration points, or for the relaxed
model was not measured directly and can be inferred only from the
corresponding Level A workloads.

A single data-generating mechanism was used, with right censoring only.
Delayed entry and left or interval censoring add terms to each likelihood
evaluation and would be expected to reduce the share of the total cost that
predictor reuse removes. For
`r n_points_fallback` data sets the timings were taken at fallback parameter
values rather than at draws near the posterior mode. The cost of the
incomplete gamma functions in the generalized gamma likelihood depends on the
parameter values, but the reductions at the two kinds of points were nearly
identical (see Results).

Although each unit started only when the load average was below the stated
threshold, the machine was not otherwise idle; the recorded load averages are
reported above. Background activity adds variability to individual timings,
while the randomized order of data sets and the balanced order of methods
within blocks prevent it from favoring either method systematically. In
Level B, the second fit of each pair started under the residual load of the
first. The alternation of the two settings balanced this exactly for the
Weibull scenario (`r reuse_first_n[["weibull_n500"]]` of
`r n_datasets[["weibull_n500"]]` data sets with predictor reuse first) and
approximately for the M-spline scenario (`r reuse_first_n[["mspline_n300"]]`
of `r n_datasets[["mspline_n300"]]`). Weighting the two orders equally gives
reductions per leapfrog step of
`r fmt_pct(pct(order_balanced[["weibull_n500"]]), 1)`% for the Weibull
scenario and `r fmt_pct(pct(order_balanced[["mspline_n300"]]), 1)`% for the
M-spline scenario.

Finally, the processor has four performance cores and four efficiency cores,
and the assignment of processes to core types was left to the operating
system. A chain scheduled on an efficiency core runs more slowly, which is a
plausible source of the variability between data sets in Level B, where four
chains ran concurrently.

### Conclusion

Predictor reuse removes redundant computation from the survival models without
changing the model, the posterior distribution, or the computed values beyond
the final digits of floating-point sums. In this study it reduced the time per
evaluation of the log density and its gradient by
`r fmt_pct(median_off, 1)`% in the median workload and by up to
`r fmt_pct(range_off[2])`%, with the largest reductions for the M-spline baseline, wide designs, and few integration points,
and the smallest for the generalized gamma distribution. In complete Weibull
fits the reduction in elapsed time was of the order of
`r fmt_pct(pct(per_scenario$wall[per_scenario$scenario == "weibull_n500"]))`%,
smaller than the reduction per evaluation, as expected from the parts of a fit
that predictor reuse does not affect. Because the optimization is enabled by
default, these reductions apply to survival fits without any change to user
code; `optimization = FALSE` remains available for benchmarking and for
reproducing fits made with earlier releases.

## Reproducibility

The study can be reproduced from the root of the package source, with that
source installed:

```{r reproduce, eval = FALSE}
# Each stage records every completed unit and resumes from there if interrupted.
system("Rscript data-raw/simulate_survival_performance.R fixed")
system("Rscript data-raw/simulate_survival_performance.R fits")
system("Rscript data-raw/simulate_survival_performance.R assemble")
```

The final stage writes the results files and the manifest, which records the
commit of the package source, the software versions, and the machine.

