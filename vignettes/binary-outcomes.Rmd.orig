options(width = 100, rstan_refresh = 0,
        # Fit MCMC chains in parallel at precompile time (rstan under Rscript
        # otherwise defaults to mc.cores = 1 and runs chains sequentially).
        mc.cores = parallel::detectCores(),
        # The precompiled .Rmd has no \VignetteIndexEntry (it lives in
