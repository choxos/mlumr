# Stan/Rcpp C++ in src/ is auto-generated by rstantools::rstan_config()
# (see ./configure) from inst/stan/*.stan. Mark it linguist-generated so
# GitHub's language stats reflect the real sources (R + Stan), and so these
# files collapse in diffs/PRs. They remain tracked and buildable.
src/stanExports_*.cc   linguist-generated=true
src/stanExports_*.h    linguist-generated=true
src/RcppExports.cpp    linguist-generated=true

# Bundled StanHeaders-style C++ headers under inst/include (if any) are vendored.
inst/include/**        linguist-vendored=true
