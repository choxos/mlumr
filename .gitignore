.Rproj.user/

# R CMD build output
/*.tar.gz

# R CMD check output
/*.Rcheck/

# Vignette build output
vignettes/*.html
vignettes/*.pdf

# knitr / R Markdown caches
*_cache/
/cache/
*.utf8.md
*.knit.md

# R environment
.Renviron

# OAuth tokens (httr)
.httr-oauth

# pkgdown rendered site
docs/

# rsconnect deployments
rsconnect/

