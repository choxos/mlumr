*.o
*.so
*.dll
src/*.o
src/*.so
src/*.dll
src/Makevars
src/Makevars.win
src/stan_meta_header.hpp

# CmdStan-compiled binaries inside inst/stan (only .stan sources are tracked)
inst/stan/**
!inst/stan/*.stan
!inst/stan/include/
!inst/stan/include/*.stan

